# ── 运行时数据与二进制（体积大，禁止入库，CLAUDE.md §11）──────────────
.data/
.tools/
traces/
data/plans/
# 摄取暂存区（M6 §9.1 第 7 条：清理策略留给 M8）
data/uploads/
*.sqlite
*.db

# ── 机密 ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── 模型权重 ─────────────────────────────────────────────────────────
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.pdparams
*.pdmodel

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── 测试与工具缓存 ───────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── 日志与临时产物 ───────────────────────────────────────────────────
*.log
logs/
tmp/
.DS_Store

# ── 编辑器 ───────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/settings.json

# Claude Code 本地设置与临时文件
.claude/settings.local.json
.claude/*.tmp.*

# 本机临时产物（PR 正文草稿等），不入库
.local/

# ── 离线交付包的构建产物（v6 §11.4）─────────────────────────────────
# 构建**脚本与模板**入库（deploy/offline-package/），**产物不入库**：
# wheels 约 6 GB、模型权重约 14 GB，进 Git 就是把仓库变成一个下载站。
# 产物默认落在 .release/，由 deploy/offline-package/build_package.sh 生成。
.release/
deploy/compose/env/*.env
!deploy/compose/env/*.env.example
